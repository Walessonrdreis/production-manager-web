generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Catalog {
  id        String   @id
  data      String
  updatedAt DateTime @updatedAt
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Collaborator {
  id        String   @id
  name      String
  role      String?
  metrics   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  category  String?
  dailyGoal Int?
  sectorId  String?
  status    String?  @default("active")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Customer {
  id        String   @id
  data      String
  updatedAt DateTime @updatedAt
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Goal {
  id                 String   @id
  createdAt          DateTime @default(now())
  updatedAt DateTime @updatedAt
  collaboratorId     String?
  collaboratorName   String?
  isActive           Boolean  @default(true)
  lastModified       String?
  period             String
  productCode        String?
  productDescription String?
  sectorId           String?
  sectorName         String?
  synced             Boolean  @default(true)
  targetQuantity     Int
  type               String?
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Order {
  id        String   @id
  data      String
  updatedAt DateTime @updatedAt
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model PlanningBatch {
  id        String   @id
  name      String
  date      String
  status    String
  createdBy String
  synced    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model PlanningItem {
  id          String   @id
  batchId     String
  productCode String
  description String
  unit        String?
  quantity    Int
  sectorId    String?
  sectorName  String?
  synced      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ProducedRecord {
  id          String   @id
  description String
  quantity    Int
  orderId     String?
  orderNumber String?
  synced      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Product {
  id        String   @id
  name      String
  code      String?
  price     Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ProductionOrder {
  id                 String    @id
  lote               String
  productId          String?
  productCode        String
  productDescription String
  quantity           Int
  sectorId           String?
  sectorName         String?
  collaboratorId     String?
  collaboratorName   String?
  status             String
  startDate          DateTime?
  endDate            DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt DateTime @updatedAt
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model ProductionSchedule {
  id          String    @id
  productCode String
  description String
  quantity    Int?
  sectorId    String?
  sectorName  String?
  scheduledAt DateTime?
  notes       String?
  synced      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt DateTime @updatedAt
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model Stock {
  id        String   @id
  data      String
  updatedAt DateTime @updatedAt
}

model OmieProduct {
  id                String         @id
  omieId            String
  sku               String?
  description       String
  active            Boolean        @default(true)
  rawPayload        Json
  lastSyncAt        DateTime
  omieCode          String         @unique
  familyDescription String?

  productStock      ProductStock?  
}

model ProductStock {
  id             String       @id @db.Uuid
  omieCode       String       @unique
  stockQuantity  Decimal
  minimumStock   Decimal
  capturedAt     DateTime
  updatedAt DateTime @updatedAt

  product        OmieProduct? @relation(fields: [omieCode], references: [omieCode])

  @@map("product_stock")
}
