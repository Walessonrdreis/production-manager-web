// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id        String   @id
  name      String
  code      String?
  price     Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductionOrder {
  id                 String    @id
  lote               String
  productId          String?
  productCode        String
  productDescription String
  quantity           Int
  sectorId           String?
  sectorName         String?
  collaboratorId     String?
  collaboratorName   String?
  status             String
  startDate          DateTime?
  endDate            DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Goal {
  id                 String   @id
  type               String?
  productCode        String?
  productDescription String?
  collaboratorId     String?
  collaboratorName   String?
  sectorId           String?
  sectorName         String?
  targetQuantity     Int
  period             String
  isActive           Boolean  @default(true)
  synced             Boolean  @default(true)
  lastModified       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

model Collaborator {
  id        String   @id
  name      String
  role      String?
  sectorId  String?
  category  String?
  dailyGoal Int?
  status    String?  @default("active")
  metrics   String? // Store JSON as string
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id        String   @id
  data      String
  updatedAt DateTime @updatedAt
}

model Customer {
  id        String   @id
  data      String
  updatedAt DateTime @updatedAt
}

model Catalog {
  id        String   @id
  data      String
  updatedAt DateTime @updatedAt
}

model Stock {
  id        String   @id
  data      String
  updatedAt DateTime @updatedAt
}

model ProducedRecord {
  id          String   @id
  description String
  quantity    Int
  orderId     String?
  orderNumber String?
  synced      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model PlanningBatch {
  id        String   @id
  name      String
  date      String
  status    String
  createdBy String
  synced    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PlanningItem {
  id          String   @id
  batchId     String
  productCode String
  description String
  unit        String?
  quantity    Int
  sectorId    String?
  sectorName  String?
  synced      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProductionSchedule {
  id          String    @id
  productCode String
  description String
  quantity    Int?
  sectorId    String?
  sectorName  String?
  scheduledAt DateTime?
  notes       String?
  synced      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ProductStock {
  omieCode      String   @id @map("omieCode")
  stockQuantity Decimal  @map("stockQuantity")
  minimumStock  Decimal  @map("minimumStock")
  updatedAt     DateTime @updatedAt @map("updatedAt")

  @@map("product_stock")
}
