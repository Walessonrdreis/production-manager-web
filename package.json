{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "tsx server.ts",
    "start": "node dist/server.cjs",
    "build": "vite build --config apps/web/vite.config.ts && esbuild server.ts --bundle --platform=node --target=node22 --packages=external --outfile=dist/server.cjs",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "update-structure": "node scripts/update-structure.js"
  },
  "dependencies": {
    "@google/genai": "^1.29.0",
    "@types/node-cron": "^3.0.11",
    "@vitejs/plugin-react": "^5.0.4",
    "date-fns": "^4.1.0",
    "node-cron": "^4.2.1",
    "vite": "^6.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/uuid": "^10.0.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.0",
    "jsdom": "^29.0.2",
    "msw": "^2.13.4",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vitest": "^4.1.4"
  }
}
